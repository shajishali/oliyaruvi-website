# Copy to .env and fill in the Supabase values.
# Never commit .env. Never put the service-role key in a VITE_ variable.

PORT=4000
PUBLIC_SITE_URL=http://localhost:4000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Grants super_admin only if this email already exists in Supabase Auth.
# The seed script does not create a password.
SEED_SUPER_ADMIN_EMAIL=

# Browser. Same project URL and anon key as above. Not the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used by Vite dev. Leave empty in production so the site calls /api on the same origin.
VITE_API_URL=http://localhost:4000

# Local admin when Supabase is not configured. Leave empty to disable.
# Development only. Never use this in production.
ALLOW_LOCAL_ADMIN=1
LOCAL_ADMIN_PASSWORD=local-admin
